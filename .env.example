# 本機開發時可使用以下 PostgreSQL 範例；Neon 請改成 Dashboard 提供的完整連線字串。
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

ADMIN_EMAIL=
ADMIN_NAME=店長
SHOP_CONTACT_EMAIL=

# 郵件通知：使用你的 SMTP 服務資料。Gmail 請使用應用程式密碼，不要使用一般登入密碼。
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=WEIYU 唯遇甜所
NEXT_PUBLIC_SITE_URL=http://localhost:3000
CRON_SECRET=

# Cloudinary 頭像圖片儲存；從 Cloudinary Dashboard 取得，不要提交真實密鑰。
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
